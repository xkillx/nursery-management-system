APP_ENV=local
LOG_LEVEL=info
METRICS_ENABLED=true
API_PORT=8080
API_BASE_PATH=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nursery_management

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
JWT_REFRESH_SHORT_TTL_HOURS=24

EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.local

EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_SECONDS=5
EMAIL_WORKER_BATCH_SIZE=100
EMAIL_RATE_PER_SECOND=10
EMAIL_RETRY_BACKOFF_SECONDS=5,30,120,600,3600,21600
EMAIL_MAX_ATTEMPTS=8

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

WEB_BASE_URL=http://localhost:4200

PASSWORD_RESET_TOKEN_SECRET=replace-with-strong-secret
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

INVITE_TOKEN_SECRET=replace-with-strong-secret
INVITE_TOKEN_TTL_HOURS=168

RUN_MIGRATIONS=true

CORS_ALLOWED_ORIGINS=
MAX_BODY_SIZE_BYTES=1048576

SCHEDULER_OWNER=false
RATE_LIMIT_DISABLED=false
